                                   Foreground="{StaticResource SecondaryText}" Margin="0,7,0,20" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Choose a DNS provider" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
