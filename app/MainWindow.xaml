                                    </Button>
                                    <Button x:Name="HomeDnsButton" Grid.Column="4" Style="{StaticResource SecondaryButton}" Height="78">
                                        <StackPanel>
                                            <TextBlock Text="DNS" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
