                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenPsiphonQuickButton" Grid.Column="6" Style="{StaticResource SecondaryButton}" Height="78">
                                        <StackPanel>
                                            <TextBlock Text="Psiphon" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Free fallback" Foreground="#8190A7" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenSubscriptionQuickButton" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="24" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="92" Height="92">
                                    <Ellipse Stroke="#203957" StrokeThickness="8"/>
                                    <Ellipse x:Name="HeroRing" Stroke="#40516A" StrokeThickness="8" StrokeDashArray="1.5,1.7"/>
                                    <Ellipse x:Name="HeroStatusDot" Width="20" Height="20" Fill="#64738A"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="HeroStatusText" Text="Tunnel is offline" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatusDetailText" Text="Ready to start a secure SOCKS5 tunnel." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="DashboardEndpointText" Text="SOCKS5  •  127.0.0.1:1080" Foreground="#5DD9FF" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#0C1525" CornerRadius="12" Padding="17">
                                    <StackPanel>
                                        <TextBlock Text="S E S S I O N   U P T I M E" Foreground="#66768E" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="UptimeText" Text="00:00:00" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        <TextBlock Text="Auto-reconnect protected" Foreground="#728199" FontSize="11" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="DashboardServerKindText" Text="SSH SERVER" Foreground="#65758D" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashboardServerText" Text="No server selected" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DashboardActiveProfileText" Text="No profile configured" Foreground="#718199" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="LOCAL PROXY" Foreground="#65758D" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="DashboardProxyText" Text="127.0.0.1:1080" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                        <TextBlock Text="SOCKS5 endpoint" Foreground="#718199" FontSize="11" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="CopyProxyButton" Content="Copy" Style="{StaticResource SecondaryButton}" Height="32" Padding="11,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="DashboardAuxTitleText" Text="SSH ROUTING" Foreground="#65758D" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashboardNekoStatusText" Text="Not running" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="DashboardNekoDetailText" Text="Managed by Nivan Shield" Foreground="#718199" FontSize="11" Margin="0,7,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" Background="#142B3E">
                                    <TextBlock Text="⌁" Foreground="#5DD9FF" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DashboardHealthSummaryText" Text="Connection health not tested" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DashboardHealthDetailText" Text="Measure real VPN latency, jitter, download, and upload." Foreground="#718199" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button x:Name="OpenHealthButton" Grid.Column="2" Content="Open health center" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DiagnosticStatusText" Text="Connection diagnostics ready" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DiagnosticDetailText" Text="Checks the provider, server, local proxy, internet path, and routing mode."
                                               Foreground="#718199" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="RunDiagnosticsButton" Content="Diagnose" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="OpenDiagnosticsButton" Content="Run diagnosis" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="142"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}"/>
                                    <Button x:Name="OpenFullLogsButton" Content="View all logs" Style="{StaticResource SecondaryButton}" Height="32" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox x:Name="DashboardLogBox" Grid.Row="1" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" Foreground="#8EA1B8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- CONNECTION HEALTH -->
                <ScrollViewer x:Name="HealthPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Connection health" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Verify the real path through the active VPN, not only the server port."
                                           Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="CancelQualityTestButton" Content="Cancel" Style="{StaticResource DangerButton}" Margin="0,0,10,0" IsEnabled="False"/>
                                <Button x:Name="QuickQualityTestButton" Content="Quick test" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                <Button x:Name="FullQualityTestButton" Content="Full speed test" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="78" Height="78" CornerRadius="39" Background="#14283A" BorderBrush="#23405B" BorderThickness="1">
                                    <TextBlock x:Name="HealthScoreText" Text="—" Foreground="#5DD9FF" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HealthOverallText" Text="Ready to test" FontSize="21" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="HealthDetailText" Text="Connect first, then run a quick or full test." Foreground="#8E9CB3" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="HealthProgressStageText" Text="IDLE" Foreground="#65758D" FontSize="10" FontWeight="Bold"/>
                                    <ProgressBar x:Name="HealthProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,11,0,0"/>
                                    <TextBlock x:Name="HealthProgressDetailText" Text="No test is running" Foreground="#718199" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="SERVER LATENCY" Foreground="#65758D" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HealthServerLatencyText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Direct TCP reachability" Foreground="#718199" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="VPN LATENCY" Foreground="#65758D" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HealthTunnelLatencyText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Measured inside the tunnel" Foreground="#718199" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="JITTER" Foreground="#65758D" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HealthJitterText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Latency variation" Foreground="#718199" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="REQUEST FAILURES" Foreground="#65758D" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HealthFailureRateText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Failed tunneled samples" Foreground="#718199" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="DOWNLOAD" Foreground="#65758D" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HealthDownloadText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Actual VPN throughput" Foreground="#718199" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource Card}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="UPLOAD" Foreground="#65758D" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HealthUploadText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Actual VPN throughput" Foreground="#718199" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Recent tests" Style="{StaticResource SectionTitle}"/>
                                    <TextBox x:Name="HealthHistoryBox" Height="150" Margin="0,12,0,0" Background="#0A1220" BorderBrush="#20304A" BorderThickness="1" Foreground="#9CB0C8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" Padding="12" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Test behavior" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Quick test uses a small download and upload. Full test uses more data for a steadier result. Both are forced through Nivan's active local proxy."
                                               Foreground="#91A1B8" TextWrapping="Wrap" LineHeight="19" Margin="0,11,0,0"/>
                                    <TextBlock Text="Speed measurements use Cloudflare's public speed-test endpoints. Do not run a full test on a limited data plan."
                                               Foreground="#FFBD69" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- CONNECTION PROFILES -->
                <Grid x:Name="ProfilesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="ProfilesPageTitleText" Text="Connection profiles" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="ProfilesPageSubtitleText" Text="Organize SSH and V2Ray servers, choose the active route, and compare availability in parallel."
                                       Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button x:Name="NewProfileButton" Content="New profile" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button x:Name="TestAllProfilesButton" Content="Test all profiles" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="390"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBox x:Name="ProfileSearchInput" Style="{StaticResource Input}" ToolTip="Search by name, category, host, or username"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ProfileCategoryFilter" Grid.Column="0" ToolTip="Filter category">
                                            <ComboBoxItem Content="All categories" Tag="__all__" IsSelected="True"/>
                                        </ComboBox>
                                        <ComboBox x:Name="ProfileSortInput" Grid.Column="2" ToolTip="Sort profiles" SelectedIndex="0">
                                            <ComboBoxItem Content="Recommended" Tag="Recommended"/>
                                            <ComboBoxItem Content="Latency" Tag="Latency"/>
                                            <ComboBoxItem Content="Name" Tag="Name"/>
                                            <ComboBoxItem Content="Category" Tag="Category"/>
                                            <ComboBoxItem Content="Protocol" Tag="Protocol"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock x:Name="ProfileShortcutHintText"
                                               Text="Shortcuts: Ctrl+A select all  •  Delete remove  •  Ctrl+D duplicate  •  Ctrl+N new SSH"
                                               Foreground="#64758E" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ListBox x:Name="ProfileList"
                                         Grid.Row="2"
                                         SelectionMode="Extended"
                                         Background="#0A1220"
                                         BorderBrush="#22314C"
                                         BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="5,4"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ProfileItemBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ProfileItemBorder" Property="Background" Value="#16243A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ProfileItemBorder" Property="Background" Value="#1A304B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding StatusBrush}" CornerRadius="2"/>
                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FavoriteLabel}" Foreground="#FFBD69" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="#F3F7FF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ActiveLabel}" Foreground="#5DD9FF" FontSize="9" FontWeight="Bold" Margin="8,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Endpoint}" Foreground="#8292AA" FontFamily="Consolas" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding LatencyDisplay}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding EngineLabel}" Foreground="#687991" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SelectedProfileStatusText" Text="Select a profile to edit" Foreground="#74859D" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="SelectAllProfilesButton" Content="Select all" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0"/>
                                        <Button x:Name="DuplicateProfileButton" Content="Duplicate" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="8,0,0,0"/>
                                        <Button x:Name="DeleteProfileButton" Content="Delete selected" Style="{StaticResource DangerButton}" Height="34" Padding="12,0" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Profile identity" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Profile name" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="ProfileNameInput" Style="{StaticResource Input}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Category" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="ProfileCategoryInput" Style="{StaticResource Input}"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="ProfileFavoriteCheck" Content="Pin as a favorite profile" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="ProfileEngineText" Text="Engine: SSH" Foreground="#5DD9FF" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SshProfileEditorPanel" Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="SSH endpoint" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Host" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="ProfileHostInput" Style="{StaticResource Input}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SSH port" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="ProfilePortInput" Style="{StaticResource Input}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Username" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="ProfileUserInput" Style="{StaticResource Input}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Local SOCKS5 port" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="ProfileSocksPortInput" Style="{StaticResource Input}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ProxyProfileEditorPanel" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Imported proxy endpoint" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Protocol" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="ProxyProtocolText" Text="VLESS" FontSize="15" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Server" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="ProxyServerText" Text="example.com:443" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Transport / security" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="ProxyTransportText" Text="ws  •  tls" FontSize="13"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Local SOCKS5 port" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="ProxyLocalPortInput" Style="{StaticResource Input}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="ProxyCredentialStatusText"
                                                   Text="Encrypted credential available"
                                                   Foreground="#39DBA0"
                                                   FontSize="11"
                                                   Margin="0,13,0,0"/>
                                        <TextBlock Text="Protocol credentials are protected with Windows DPAPI. Re-import the link to change endpoint, transport, TLS, or Reality options."
                                                   Foreground="#74859D"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Availability" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="ProfileTestDetailText" Text="This profile has not been tested yet." Foreground="#8393AB" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="TestSelectedProfileButton" Grid.Column="1" Content="Test profile" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="EditAdvancedProfileButton" Content="Advanced SSH settings" Style="{StaticResource SecondaryButton}"/>
                                        <Button x:Name="SetActiveProfileButton" Content="Use &amp; connect" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="SaveProfileButton" Content="Save profile" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="Use &amp; connect selects this profile and starts the connection in one step."
                                           Foreground="#74859D" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- SSH CONNECTION -->
                <ScrollViewer x:Name="ConnectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SSH" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Enter the server once, save the password, and connect." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button x:Name="SshDisconnectButton" Content="Disconnect" Style="{StaticResource DangerButton}" Margin="0,0,10,0" IsEnabled="False" Visibility="Collapsed"/>
                                <Button x:Name="SshConnectButton" Content="Save &amp; connect" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Server" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="HostInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SSH port" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="PortInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Username" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="UserInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,15,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Local SOCKS5 port" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SocksPortInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Host key handling" Style="{StaticResource Label}"/>
                                        <TextBox Style="{StaticResource Input}"
                                                 Text="Auto-accept after clearing the old key"
                                                 IsReadOnly="True"
                                                 ToolTip="Locked to the original working SSH flow"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Authentication" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mode" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="AuthModeInput">
                                            <ComboBoxItem Content="Password" Tag="Password"/>
                                            <ComboBoxItem Content="Private key" Tag="Private key"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Private key path (optional)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="KeyPathInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <Button x:Name="BrowseKeyButton" Grid.Column="3" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="10,25,0,0"/>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SSH password" Style="{StaticResource Label}"/>
                                        <PasswordBox x:Name="PasswordInput"
                                                     Height="40"
                                                     Padding="12,8"
                                                     Background="#0C1424"
                                                     Foreground="#F3F7FF"
                                                     BorderBrush="#293854"
                                                     BorderThickness="1"
                                                     FontSize="14"/>
                                    </StackPanel>
                                    <Button x:Name="ClearSavedPasswordButton"
                                            Grid.Column="1"
                                            Content="Clear saved"
                                            Style="{StaticResource DangerButton}"
                                            Margin="10,25,0,0"/>
                                </Grid>
                                <CheckBox x:Name="AutoLoginCheck"
                                          Content="Use the encrypted saved password automatically for connection and reconnect"
                                          Margin="0,13,0,0"/>
                                <TextBlock x:Name="PasswordStatusText"
                                           Text="No password is saved."
                                           Foreground="#74859D"
                                           FontSize="11"
                                           Margin="0,7,0,0"/>
                                <TextBlock Text="The password is encrypted with Windows DPAPI for this Windows account and is never stored in settings.json or process arguments."
                                           TextWrapping="Wrap"
                                           Foreground="#74859D"
                                           FontSize="11"
                                           Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Reliability" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Keep-alive interval (seconds)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="KeepAliveInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Missed keep-alive limit" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="KeepAliveCountInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Reconnect delay (seconds)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="ReconnectDelayInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="AutoReconnectCheck" Content="Reconnect automatically after a dropped connection" Margin="0,15,0,0"/>
                                <CheckBox x:Name="ClearHostKeyCheck"
                                          Content="Always remove the old SSH host key before Connect (matches the original script)"
                                          IsChecked="True"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                <Button x:Name="ForgetHostKeyButton" Content="Forget saved host key" Style="{StaticResource DangerButton}"/>
                                <Button x:Name="TestServerConnectionButton" Content="Test server" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="SaveConnectionButton" Content="Save SSH settings" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- V2RAY AND SING-BOX -->
                <ScrollViewer x:Name="V2RayPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="V2Ray" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Paste a config or add a subscription. Nivan handles the core automatically."
                                           Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button x:Name="OpenServersButton" Content="Choose server" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                <Button x:Name="V2RayDisconnectButton" Content="Disconnect" Style="{StaticResource DangerButton}" Margin="0,0,10,0" IsEnabled="False" Visibility="Collapsed"/>
                                <Button x:Name="V2RayConnectButton" Content="Connect" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#0C1525" BorderBrush="#20304A" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,16">
                            <TextBlock x:Name="V2RayConnectionStatusText"
                                       Text="Import a config or subscription, then press Connect."
                                       Foreground="#91A1B8"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Saved V2Ray profile" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="V2RayProfileStatusText" Text="Only V2Ray configs appear here."
                                               Foreground="#74859D" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="V2RayProfileInput" Grid.Column="2" DisplayMemberPath="Name" VerticalAlignment="Center"/>
                                <Button x:Name="UseV2RayProfileButton" Grid.Column="4" Content="Use this profile"
                                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Subscriptions" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Add a link once. Its compatible servers are downloaded and imported immediately; no separate refresh or save step is required."
                                           Foreground="#74859D" FontSize="11" Margin="0,7,0,14" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Subscription name" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SubscriptionNameInput" Style="{StaticResource Input}" ToolTip="Example: Main servers"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Subscription URL" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SubscriptionUrlInput" Style="{StaticResource Input}" ToolTip="Paste the complete subscription URL here"/>
                                    </StackPanel>
                                    <Button x:Name="DownloadSubscriptionButton" Grid.Column="4" Content="Add &amp; import now"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                                </Grid>
                                <Grid Margin="0,11,0,11">
                                    <TextBox x:Name="SubscriptionCategoryInput" Text="Subscription" Visibility="Collapsed"/>
                                    <CheckBox x:Name="SubscriptionAutoUpdateCheck" Content="Refresh automatically every 24 hours"/>
                                    <TextBlock x:Name="SubscriptionStatusText" Text="No managed subscription selected."
                                               Foreground="#74859D" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox x:Name="SubscriptionList" Height="150" Background="#0A1220" BorderBrush="#20304A"
                                         BorderThickness="1" Foreground="#F3F7FF" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="#718199" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ProfileCount}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding LastStatus}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastUpdated}" Foreground="#718199" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                                    <Button x:Name="RemoveSubscriptionButton" Content="Remove" Style="{StaticResource DangerButton}" Margin="0,0,10,0"/>
                                    <Button x:Name="RefreshSelectedSubscriptionButton" Content="Refresh selected" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                    <Button x:Name="RefreshAllSubscriptionsButton" Content="Refresh all" Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Portable proxy core" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Secure mode runs only the reviewed Neko core included with Nivan Shield. Custom executable loading is disabled."
                                                   Foreground="#74859D" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="TestSingBoxButton" Content="Check core" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <CheckBox x:Name="UseBundledCoreCheck"
                                          Content="Use the portable core included with Nivan Shield (recommended)"
                                          Margin="0,0,0,14"/>
                                <TextBlock Text="Executable path" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SingBoxPathInput" Style="{StaticResource Input}"/>
                                    <Button x:Name="BrowseSingBoxButton" Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="SingBoxStatusText" Text="Core has not been checked yet." Foreground="#74859D" FontSize="11" Margin="0,8,0,0"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SingBoxAutoReconnectCheck" Content="Restart sing-box automatically if it exits"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Reconnect delay (seconds)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SingBoxReconnectDelayInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <Button x:Name="SaveSingBoxButton" Grid.Column="2" Content="Save core settings" Style="{StaticResource PrimaryButton}" Margin="12,25,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="1. Paste a V2Ray config" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Paste one or more vmess://, vless://, trojan:// or ss:// links. The first imported server becomes ready to connect automatically."
                                           Foreground="#74859D" FontSize="11" Margin="0,7,0,14"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="0"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="VMess / VLESS / Trojan / Shadowsocks" Foreground="#5DD9FF" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Visibility="Collapsed">
                                        <TextBlock Text="Import category" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="ImportCategoryInput" Text="V2Ray" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="ConfigImportInput"
                                         Height="120"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource Input}"
                                         FontFamily="Consolas"
                                         ToolTip="Paste share links here"/>
                                <Grid Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PasteConfigsButton" Content="Paste clipboard" Style="{StaticResource SecondaryButton}"/>
                                        <Button x:Name="ImportConfigFileButton" Content="Import file..." Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                                        <Button x:Name="ImportQrConfigButton" Content="Import QR image..." Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                                ToolTip="Offline QR import — shortcut is configurable in Settings"/>
                                    </StackPanel>
                                    <Button x:Name="ImportConfigsButton" Content="Import &amp; use" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="ImportResultText"
                                           Text="Imported credentials will be encrypted separately for each profile."
                                           Foreground="#74859D"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="2. Add a subscription link" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Paste the HTTPS subscription link once. Servers are imported now and can be refreshed later."
                                           Foreground="#74859D" FontSize="11" Margin="0,7,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Subscription name" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="LegacySubscriptionNameInput" Style="{StaticResource Input}" ToolTip="Example: Main servers"/>
                                        <TextBlock Text="Subscription URL" Style="{StaticResource Label}" Margin="0,12,0,7"/>
                                        <TextBox x:Name="LegacySubscriptionUrlInput" Style="{StaticResource Input}" ToolTip="Paste the complete subscription URL here"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Visibility="Collapsed">
                                            <TextBlock Text="Category" Style="{StaticResource Label}"/>
                                            <TextBox x:Name="LegacySubscriptionCategoryInput" Text="Subscription" Style="{StaticResource Input}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="LegacySubscriptionAutoUpdateCheck" Content="Refresh automatically every 24 hours" Margin="0,13,0,0"/>
                                        <Button x:Name="LegacyDownloadSubscriptionButton"
                                                Content="Add subscription"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#0A1220" BorderBrush="#20304A" BorderThickness="1" CornerRadius="10" Margin="0,16,0,0" Padding="6">
                                    <ListBox x:Name="LegacySubscriptionList" Height="135" Background="Transparent" BorderThickness="0" Foreground="#F3F7FF" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,2"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="SubscriptionItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,9">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="SubscriptionItemBorder" Property="Background" Value="#152238"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="SubscriptionItemBorder" Property="Background" Value="#1A304B"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Category}" Foreground="#718199" FontSize="10" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ProfileCount}"/>
                                                        <TextBlock Text="{Binding AutoUpdateLabel}" Foreground="#5DD9FF" FontSize="9" FontWeight="Bold" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding LastStatus}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding LastUpdated}" Foreground="#718199" FontSize="10" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
