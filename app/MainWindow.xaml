                                        <TextBox x:Name="ShortcutImportQrInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="New connection" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="ShortcutNewConnectionInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Select all profiles" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="ShortcutSelectAllInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Delete profiles" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="ShortcutDeleteInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="Duplicate profile" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="ShortcutDuplicateInput" Style="{StaticResource Input}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Application updates" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="CheckUpdatesOnStartupCheck"
                                          Content="Check the configured update manifest when Nivan Shield starts"/>
                                <TextBlock Text="Update manifest URL (HTTPS)" Style="{StaticResource Label}" Margin="0,8,0,7"/>
                                <TextBox x:Name="UpdateManifestUrlInput" Style="{StaticResource Input}" ToolTip="Vendor manifest containing version, download_url, sha256, and notes"/>
                                <Grid Margin="0,13,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateStatusText" Text="No update source configured." Foreground="#74859D" FontSize="11"/>
                                        <ProgressBar x:Name="UpdateProgressBar" Width="300" HorizontalAlignment="Left" Value="0" Margin="0,9,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Button x:Name="OpenUpdateFolderButton" Content="Open folder" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                        <Button x:Name="DownloadUpdateButton" Content="Download verified ZIP" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" IsEnabled="False"/>
                                        <Button x:Name="CheckUpdatesButton" Content="Check now" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Nivan verifies the ZIP against the SHA-256 value in the manifest and never installs it automatically. A public release should additionally sign the manifest and EXE."
                                           Foreground="#74859D" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Security" Style="{StaticResource SectionTitle}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#91A1B8" LineHeight="21" Margin="0,12,0,0"
                                           Text="Saved SSH passwords are protected per profile by Windows DPAPI for the current Windows user. To preserve the original working flow, the saved host-key entry is removed before every connection and the new key is accepted automatically."/>
                                <TextBlock TextWrapping="Wrap" Foreground="#91A1B8" LineHeight="21" Margin="0,10,0,0"
                                           Text="Automatic login uses a private SSH_ASKPASS helper. The password is never placed in command-line arguments, settings.json, or logs."/>
                                <TextBlock TextWrapping="Wrap" Foreground="#91A1B8" LineHeight="21" Margin="0,10,0,0"
                                           Text="Imported proxy UUIDs and passwords are also DPAPI-protected per profile. sing-box receives them through a temporary runtime configuration that is removed after disconnect."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Nivan Shield" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Version 6.0.5  •  Open-source multi-provider client" Foreground="#74849B" Margin="0,7,0,0"/>
                                    <TextBlock Text="Making access to the free and open internet easier."
                                               Foreground="#5DD9FF" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ExitAppButton" Content="Exit application" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
