                                    </Button>
                                    <Button x:Name="OpenConfigQuickButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="78">
                                        <StackPanel>
                                            <TextBlock Text="V2Ray" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Config &amp; subscription" Foreground="#8190A7" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
