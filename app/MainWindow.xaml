                            <StackPanel>
                                <TextBlock Text="How it works" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Nivan keeps the original SSH flow on 127.0.0.1:1080, then the bundled core creates an integrated mixed proxy and optional TUN adapter. DNS uses encrypted DoH through the SSH route. The core configuration is temporary and is removed after Disconnect."
                                           Foreground="#91A1B8" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

