                            <StackPanel>
                                <TextBlock Text="Safe restore" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="DnsRestoreOnDisconnectCheck" Content="Restore the previous DNS whenever VPN disconnects"/>
                                <CheckBox x:Name="DnsRestoreAfterCrashCheck" Content="Restore DNS automatically after an unclean Nivan shutdown"/>
                                <TextBlock Text="Nivan saves the previous adapter state before the first DNS change. Restore is always available even if a DNS test fails."
                                           Foreground="#74859D" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
