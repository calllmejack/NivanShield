                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Routing modes" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="NekoSystemProxyCheck"
                                          Content="System Proxy — managed automatically by the Home routing mode" IsEnabled="False"/>
                                <CheckBox x:Name="NekoTunCheck"
                                          Content="TUN mode — managed automatically by the Home routing mode" IsEnabled="False"/>
                                <TextBlock Text="Choose Browser only, Selected applications, Whole Windows, or System Proxy on Home. Whole Windows enables TUN and System Proxy together for NekoRay-compatible behavior."
                                           Foreground="#74859D" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,16"/>
                                <Grid Width="330" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Integrated HTTP/SOCKS port" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="NekoMixedPortInput" Grid.Column="1" Style="{StaticResource Input}" Text="2080"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Automation" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="NekoEnabledCheck" Content="Enable integrated routing for SSH connections"/>
                                <CheckBox x:Name="NekoAutoStartCheck" Content="Start automatically after the SSH SOCKS port is ready"/>
                                <CheckBox x:Name="NekoCloseCheck" Content="Always stop routing and remove LAN Proxy on Disconnect" IsEnabled="False" IsChecked="True"/>
                                <StackPanel Width="260" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <TextBlock Text="Start delay after SSH connects (seconds)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="NekoDelayInput" Style="{StaticResource Input}"/>
