                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StopNekoButton" Content="Stop routing" Style="{StaticResource DangerButton}" IsEnabled="False" Margin="0,0,10,0"/>
