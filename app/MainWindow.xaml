                                   Foreground="{StaticResource SecondaryText}" Margin="0,7,0,20"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
