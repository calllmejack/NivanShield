                <!-- INTEGRATED SSH ROUTING -->
                <ScrollViewer x:Name="NekoRayPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Integrated SSH routing" Style="{StaticResource PageTitle}"/>
